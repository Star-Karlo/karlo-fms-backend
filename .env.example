# Copy to .env and adjust. All have local-dev defaults in internal/platform/config.

API_ADDR=:8080

# App database (separate from the telemetry pipeline DB). Host port 5433 in compose.
DATABASE_URL=postgres://fms_app:fms_app@localhost:5433/fms_app
REDIS_ADDR=localhost:6380

# Auth
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Telemetry pipeline (fms-tracking). Local ingest is :8082; prod is the URL below.
TELEMETRY_BASE_URL=http://localhost:8082
# TELEMETRY_BASE_URL=https://fms-tracking.karlo.id
TELEMETRY_API_KEY=
TELEMETRY_TIMEOUT_MS=4000
LIVE_CACHE_TTL_SEC=8
# Must equal telemetry's RETENTION_DAYS (7 in production): older history is in
# Athena, which the bulk behaviour endpoint (GET /v1/vehicles/behavior) refuses
# to scan per truck.
TELEMETRY_HOT_DAYS=7
# Trucks all bulk behaviour requests together compute at once; each is a
# telemetry history fetch, so this is how hard the endpoint may push telemetry.
BULK_BEHAVIOR_CONCURRENCY=4

# Dashcam auto-save: every event clip of these customers is copied to S3.
# Empty DASHCAM_AUTOSAVE_TENANTS = off. Production: 1 (SIBA) -> sibasuryastorage.
DASHCAM_AUTOSAVE_TENANTS=
# customer=bucket pairs; manual saves of that customer go there too.
DASHCAM_TENANT_BUCKETS=
DASHCAM_AUTOSAVE_INTERVAL=30m
DASHCAM_AUTOSAVE_LOOKBACK=72h
DASHCAM_AUTOSAVE_MAX_INFLIGHT=20
# Local S3 (telemetry's LocalStack): uncomment with test credentials to play saved clips.
# AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
